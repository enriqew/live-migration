{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "target",
  "database.port": "5432",
  "database.user": "fleet",
  "database.password": "fleet",
  "database.dbname": "fleet",
  "topic.prefix": "fleet",

  "plugin.name": "pgoutput",
  "slot.name": "reverse_fleet",
  "publication.name": "reverse_fleet",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "fleet.station,fleet.station_status,fleet.trip,migration.rollback_marker",

  "snapshot.mode": "no_data",
  "provide.transaction.metadata": "true",
  "decimal.handling.mode": "string",
  "time.precision.mode": "adaptive_time_microseconds",
  "tombstones.on.delete": "false",

  "key.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "key.converter.apicurio.registry.url": "http://registry:8080/apis/registry/v3",
  "key.converter.apicurio.registry.auto-register": "true",
  "key.converter.apicurio.registry.find-latest": "true",
  "value.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "value.converter.apicurio.registry.url": "http://registry:8080/apis/registry/v3",
  "value.converter.apicurio.registry.auto-register": "true",
  "value.converter.apicurio.registry.find-latest": "true",

  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "delete",
  "topic.creation.default.retention.ms": "604800000"
}
